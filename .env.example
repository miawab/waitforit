# Copy this file to .env. Everything is optional except ONE way to run the model.

# --- The model: set at least one. Order tried: Ollama, then AI Studio, then Groq. ---
# Gemma on your own PC. First run: ollama pull gemma4:e4b-it-qat
OLLAMA_URL=http://localhost:11434
# Gemma hosted on Google AI Studio
GEMINI_API_KEY=
# An open-weight model (gpt-oss-120b) on Groq's free plan, used when AI Studio is out of quota
GROQ_API_KEY=

# --- Optional ---
# Watches without a link search the news (SerpApi free plan: 250 searches a month)
SERPAPI_KEY=
# Voice notes when something happens (made only when you press play)
ELEVENLABS_API_KEY=

# --- Leave empty on your own PC ---
# Watches are saved in data/store.json and notification keys are made for you in data/vapid.json.
MONGODB_URI=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TICK_SECRET=
